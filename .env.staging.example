# -----------------------------------------------------------------------------
# Staging deployment settings for scripts/deploy-staging.sh (AWS CloudShell or any bash).
#   cp .env.staging.example .env.staging   →  fill in  →  scripts/deploy-staging.sh check
# Values with spaces must be quoted ("…"). .env.staging is git-ignored. It holds NO secrets: the push private key goes straight into
# AWS Secrets Manager, the database and personal-data keys are generated inside AWS.
# -----------------------------------------------------------------------------

# AWS account (12 digits). The script refuses to run if your CLI credentials belong to another account.
AWS_ACCOUNT_ID=
# Region for staging (and later production).
AWS_REGION=eu-north-1

# Public HTTPS address of staging, and the Route 53 hosted zone that contains it.
DOMAIN=staging.tasks.example.com
HOSTED_ZONE_NAME=example.com
# Optional: leave empty to look it up from HOSTED_ZONE_NAME.
HOSTED_ZONE_ID=

# Mailbox that receives CloudWatch alarms (confirm the SNS e-mail after the deploy).
ALARM_EMAIL=

# Image tag to deploy. Empty = current git commit (short hash), as pushed by scripts/push-images.sh.
IMAGE_TAG=

# Web Push (VAPID). Leave VAPID_PUBLIC_KEY empty: `deploy-staging.sh vapid` generates the pair,
# stores the private key in Secrets Manager and writes the public key here.
VAPID_PUBLIC_KEY=
VAPID_SECRET_NAME=dailytasks/staging/vapid-private-key
# Contact for push services (mailto: or https:). Optional.
VAPID_SUBJECT=

# First company and administrator (used by `deploy-staging.sh admin`). Quote values that contain spaces.
COMPANY_NAME="شركة الراسيات"
ADMIN_EMAIL=
ADMIN_NAME=
# ar or en
ADMIN_LOCALE=ar
