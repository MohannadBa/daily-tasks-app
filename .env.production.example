# -----------------------------------------------------------------------------
# Production deployment settings for scripts/deploy-production.sh (AWS CloudShell or any bash).
#   cp .env.production.example .env.production  →  fill in  →  scripts/deploy-production.sh check
# Values with spaces must be quoted ("…"). .env.production is git-ignored and holds NO secrets:
# the push private key goes straight into Secrets Manager; DB credentials and the personal-data
# key are generated inside AWS.
# -----------------------------------------------------------------------------

# AWS account (12 digits). The script refuses to run when the CLI credentials belong to another account.
AWS_ACCOUNT_ID=
# Fixed: production runs only in eu-north-1 (the script and the CDK refuse anything else).
AWS_REGION=eu-north-1

# Public HTTPS address and the Route 53 hosted zone (the company domain) that contains it.
DOMAIN=tasks.example.com
HOSTED_ZONE_NAME=example.com
# Optional: leave empty to look it up from HOSTED_ZONE_NAME.
HOSTED_ZONE_ID=

# Ops mailbox for CloudWatch alarms (confirm the SNS subscription e-mail after the first deploy).
ALARM_EMAIL=

# Release to deploy. Empty = current git commit (short hash), as pushed by scripts/push-images.sh.
IMAGE_TAG=

# Cognito e-mail through SES. Must be an address on HOSTED_ZONE_NAME (the DailyTasks-Mail identity).
SES_FROM_ADDRESS=no-reply@example.com
SES_FROM_NAME="الراسيات · Al-Rasiyat"

# ---------------- Launch gate ----------------
# restricted = acceptance testing: ONLY the addresses below can sign in or be created.
# Switch to open only after the launch checklist is signed off (docs/PRODUCTION_PLAN.md §8).
ACCESS_MODE=restricted
# Comma-separated, no spaces needed. Must include ADMIN_EMAIL.
ACCESS_ALLOWLIST=
# Optional extra layer: WAF blocks every source IP outside these CIDRs (e.g. the office). Phones on
# mobile data will then be blocked too — leave empty for real-device push tests away from the office.
ALLOWED_CIDRS=
# Optional WAF rate limits per IP per 5 minutes (defaults 6000 all / 200 sign-in).
WAF_RATE_LIMIT=
WAF_AUTH_RATE_LIMIT=

# Web Push (VAPID). Leave empty: `deploy-production.sh vapid` creates the pair, stores the private key
# in Secrets Manager and writes the public key here.
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# First company and administrator (`deploy-production.sh admin`). ADMIN_EMAIL must be allow-listed.
COMPANY_NAME="شركة الراسيات"
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_LOCALE=ar
