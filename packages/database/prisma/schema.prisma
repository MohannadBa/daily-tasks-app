// DailyTasks database schema. See docs/DATABASE.md for the design rationale.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  /// Company administrator (formerly COMPANY_ADMIN; renamed in migration enterprise_enums).
  ADMIN
  PROJECT_MANAGER
  EMPLOYEE
}

enum ProjectRole {
  MANAGER
  EMPLOYEE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  /// A completion submission awaits review (delegator or approving manager).
  PENDING_REVIEW
  /// Approved by the task's approver. Only approval sets this status.
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Who must decide on a pending submission.
enum ReviewStage {
  /// The employee who delegated the task (transfer chain) reviews the delegate's work.
  DELEGATOR
  /// The task approver (original manager) makes the final decision.
  MANAGER
}

enum SubmissionStatus {
  PENDING
  /// Delegator accepted the delegate's work and sent it up the chain.
  FORWARDED
  APPROVED
  REJECTED
  /// Delegator sent the delegate's work back.
  RETURNED
  WITHDRAWN
}

/// Time-ledger segment kinds (see docs/TIME_ACCOUNTING.md).
enum SegmentKind {
  /// The responsible employee is working (ASSIGNED / IN_PROGRESS). Charged to them.
  ACTIVE_WORK
  /// A transfer request awaits the recipient. Charged to the requester.
  TRANSFER_PENDING
  /// A delegate's submission awaits the delegator. Forwarded: charged to the delegator; returned/withdrawn: charged to the submitter.
  DELEGATOR_REVIEW
  /// Open manager review: clock provisionally paused until decided.
  PENDING_REVIEW
  /// Closed manager review that ended in approval: excluded from accountable time.
  APPROVED_REVIEW
  /// Closed manager review that ended in rejection/withdrawal: charged to the submitter.
  REJECTED_REVIEW
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ExtensionStatus {
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  CANCELLED
}

enum AttachmentKind {
  /// Manager-provided task instructions / reference files.
  INSTRUCTION
  COMMENT
  /// Attached to a completion submission.
  SUBMISSION
}

enum DocumentSource {
  TASK_SUBMISSION
  MANUAL
}

enum DocumentVisibility {
  PROJECT_MEMBERS
  MANAGERS_ONLY
}

enum PersonalTaskStatus {
  OPEN
  DONE
}

enum ReportType {
  TASK
  EMPLOYEE
  PROJECTS
}

enum ReportStatus {
  QUEUED
  RENDERING
  READY
  FAILED
}

enum TaskHistoryAction {
  CREATED
  UPDATED
  DEADLINE_CHANGED
  REASSIGNED
  STARTED
  COMMENTED
  ATTACHMENT_ADDED
  COMPLETED
  REOPENED
  PRIORITY_CHANGED
  DEPARTMENT_CHANGED
  SUBMITTED
  FORWARDED
  APPROVED
  REJECTED
  RETURNED
  SUBMISSION_WITHDRAWN
  TRANSFER_REQUESTED
  TRANSFER_ACCEPTED
  TRANSFER_DECLINED
  TRANSFER_CANCELLED
  EXTENSION_REQUESTED
  EXTENSION_DECIDED
  EXTENSION_CANCELLED
  APPROVER_CHANGED
  DOCUMENT_REGISTERED
}

enum AttachmentStatus {
  PENDING
  UPLOADED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_REASSIGNED
  TASK_COMMENT_ADDED
  TASK_COMPLETED
  TASK_OVERDUE
  TASK_DEADLINE_APPROACHING
  TASK_REOPENED
  /// User-requested test push from the notification settings page.
  PUSH_TEST
  TASK_SUBMITTED
  TASK_SUBMISSION_FORWARDED
  TASK_APPROVED
  TASK_REJECTED
  TASK_RETURNED
  TASK_TRANSFER_REQUESTED
  TASK_TRANSFER_ACCEPTED
  TASK_TRANSFER_DECLINED
  TASK_EXTENSION_REQUESTED
  TASK_EXTENSION_DECIDED
  DOCUMENT_REGISTERED
  USER_CREATED
  PASSWORD_CHANGE_REQUIRED
  REPORT_READY
}

/// Platform a browser push subscription was created on (derived from the user agent).
enum PushPlatform {
  IOS
  ANDROID
  DESKTOP
  OTHER
}

enum PushDeliveryStatus {
  /// Created, not yet accepted by the push service (or a transient failure awaiting retry).
  PENDING
  /// Accepted by the push service (2xx). Not proof the device displayed it.
  SENT
  /// Permanent failure (bad request, payload too large, retries exhausted).
  FAILED
  /// Push service reported the subscription gone (404/410); the subscription was deactivated.
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model Company {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String
  timezone               String   @default("Asia/Riyadh")
  /// Minutes before a deadline at which reminders are sent. Default: 24h and 1h.
  reminderOffsetsMinutes Int[]    @default([1440, 60])
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  users              User[]
  projects           Project[]
  departments        Department[]
  documentCategories DocumentCategory[]
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  email        String    @unique
  name         String
  role         UserRole
  locale       String    @default("ar")
  isActive     Boolean   @default(true)
  /// Cognito "sub" claim (production). Null until first Cognito login links the account.
  cognitoSub   String?   @unique
  /// bcrypt hash, only used in AUTH_MODE=local (development/test).
  passwordHash String?
  lastLoginAt  DateTime? @db.Timestamptz(3)
  /// Set when an admin provisions/resets the account; the user must choose a new password first.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime? @db.Timestamptz(3)
  createdById        String?   @db.Uuid
  deactivatedAt      DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  company        Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  memberships    ProjectMembership[]
  assignedTasks  Task[]               @relation("TaskAssignee")
  createdTasks   Task[]               @relation("TaskCreator")
  comments       TaskComment[]
  attachments    TaskAttachment[]
  ratingsGiven   TaskRating[]         @relation("RatingRater")
  ratingsGot     TaskRating[]         @relation("RatingEmployee")
  ratingChanges  TaskRatingRevision[]
  notifications  Notification[]
  pushSubscriptions PushSubscription[]
  historyEntries TaskHistory[]
  departmentMemberships DepartmentMembership[]
  approvingTasks        Task[]                     @relation("TaskApprover")
  submissions           TaskSubmission[]           @relation("SubmissionAuthor")
  transfersFrom         TaskTransfer[]             @relation("TransferFrom")
  transfersTo           TaskTransfer[]             @relation("TransferTo")
  extensionRequests     DeadlineExtensionRequest[] @relation("ExtensionRequester")
  personalTasks         PersonalTask[]
  documentsUploaded     ProjectDocument[]
  reportJobs            ReportJob[]

  @@index([companyId, role])
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  archivedAt  DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  memberships ProjectMembership[]
  tasks       Task[]
  documents   ProjectDocument[]

  @@index([companyId, status])
}

/// A user's role inside one project. Removal is a soft delete (removedAt) so history stays intact;
/// all authorization checks require removedAt IS NULL.
model ProjectMembership {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole
  removedAt DateTime?   @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId, removedAt])
}

model Task {
  id              String     @id @default(uuid()) @db.Uuid
  projectId       String     @db.Uuid
  assigneeId      String     @db.Uuid
  createdById     String     @db.Uuid
  title           String
  description     String     @default("")
  deadline        DateTime   @db.Timestamptz(3)
  status          TaskStatus @default(ASSIGNED)
  startedAt       DateTime?  @db.Timestamptz(3)
  completedAt     DateTime?  @db.Timestamptz(3)
  /// Set at completion time (completedAt > deadline) and never recomputed by background jobs.
  completedLate   Boolean?
  reopenCount     Int        @default(0)
  /// Incremented whenever deadline-related state changes; stale scheduled events are ignored.
  scheduleVersion Int        @default(0)
  archivedAt      DateTime?  @db.Timestamptz(3)
  /// Department chosen at assignment. Null only for tasks created before departments existed.
  departmentId    String?      @db.Uuid
  priority        TaskPriority @default(MEDIUM)
  /// Final approval authority (the assigning manager by default). Only this user (or an audited admin) can approve.
  approverId      String       @db.Uuid
  /// Deadline of the first assignment. Never changed (extensions and edits change `deadline`).
  originalDeadline DateTime    @db.Timestamptz(3)
  /// Current work cycle (1 + number of reopenings).
  currentCycle    Int          @default(1)
  // --- Denormalised time-ledger state for the current cycle (maintained in the same transaction) ---
  /// Allowed accountable time for the current cycle in ms (approved deadline − cycle start).
  budgetMs        BigInt       @default(0)
  /// Accountable ms from closed charged segments of the current cycle.
  chargedMs       BigInt       @default(0)
  /// Start of the open segment when it is charged (clock running); null while paused or completed.
  clockRunningSince DateTime?  @db.Timestamptz(3)
  /// When accountable time reaches the budget if the clock keeps running; null while paused.
  effectiveDueAt  DateTime?    @db.Timestamptz(3)
  pendingSubmissionId String?  @db.Uuid
  pendingTransferId   String?  @db.Uuid
  pendingExtensionId  String?  @db.Uuid
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee    User             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approver    User             @relation("TaskApprover", fields: [approverId], references: [id], onDelete: Restrict)
  department  Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  comments    TaskComment[]
  attachments TaskAttachment[]
  rating      TaskRating?
  history     TaskHistory[]
  cycles      TaskCycle[]
  segments    TaskTimeSegment[]
  submissions TaskSubmission[]
  transfers   TaskTransfer[]
  extensions  DeadlineExtensionRequest[]
  documents   ProjectDocument[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([status, deadline])
  @@index([departmentId, status])
  @@index([approverId, status])
  @@index([status, effectiveDueAt])
}

model TaskComment {
  id               String   @id @default(uuid()) @db.Uuid
  taskId           String   @db.Uuid
  authorId         String   @db.Uuid
  body             String
  isCompletionNote Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author      User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments TaskAttachment[]
  submission  TaskSubmission?

  @@index([taskId, createdAt])
}

/// File metadata only. Binary content lives in private S3 under a random key.
model TaskAttachment {
  id           String           @id @default(uuid()) @db.Uuid
  taskId       String           @db.Uuid
  commentId    String?          @db.Uuid
  uploadedById String           @db.Uuid
  fileName     String
  contentType  String
  sizeBytes    Int
  storageKey   String           @unique
  status       AttachmentStatus @default(PENDING)
  kind         AttachmentKind   @default(COMMENT)
  uploadedAt   DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  task       Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  comment    TaskComment? @relation(fields: [commentId], references: [id], onDelete: Restrict)
  uploadedBy User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  document   ProjectDocument?

  @@index([taskId, status])
  @@index([commentId])
}

/// One rating per task (unique taskId). Stars constrained to 1..5 by a CHECK constraint.
/// Averages are always computed from these rows; no stored average exists.
model TaskRating {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @unique @db.Uuid
  employeeId String   @db.Uuid
  raterId    String   @db.Uuid
  stars      Int      @db.SmallInt
  /// Private manager feedback. Never exposed to employees.
  feedback   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  task      Task                 @relation(fields: [taskId], references: [id], onDelete: Restrict)
  employee  User                 @relation("RatingEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  rater     User                 @relation("RatingRater", fields: [raterId], references: [id], onDelete: Restrict)
  revisions TaskRatingRevision[]

  @@index([employeeId])
}

/// Audit trail for rating creation and edits (kept separate from TaskHistory so it is never
/// exposed through the employee-visible task history).
model TaskRatingRevision {
  id               String   @id @default(uuid()) @db.Uuid
  ratingId         String   @db.Uuid
  changedById      String   @db.Uuid
  previousStars    Int?     @db.SmallInt
  newStars         Int      @db.SmallInt
  previousFeedback String?
  newFeedback      String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  rating    TaskRating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  changedBy User       @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([ratingId, createdAt])
}

model TaskHistory {
  id        String            @id @default(uuid()) @db.Uuid
  taskId    String            @db.Uuid
  actorId   String?           @db.Uuid
  action    TaskHistoryAction
  metadata  Json              @default("{}")
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

/// Persistent in-app notification. (userId, dedupeKey) is unique so redelivered events are idempotent.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  taskId    String?          @db.Uuid
  projectId String?          @db.Uuid
  dedupeKey String
  data      Json             @default("{}")
  readAt    DateTime?        @db.Timestamptz(3)
  pushedAt  DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

/// Browser Web Push subscription (one per browser/installed PWA). A user may have several.
/// The endpoint is a capability URL and, with p256dh/auth, is never returned by the API.
/// VAPID keys are NOT stored in the database (Secrets Manager / env).
model PushSubscription {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @db.Uuid
  endpoint           String       @unique
  /// Client public key (P-256, base64url) and auth secret (16 bytes, base64url) for payload encryption.
  p256dh             String
  auth               String
  userAgent          String?
  platform           PushPlatform @default(OTHER)
  isActive           Boolean      @default(true)
  /// PushSubscription.expirationTime reported by the browser, if any.
  expiresAt          DateTime?    @db.Timestamptz(3)
  lastUsedAt         DateTime?    @db.Timestamptz(3)
  failureCount       Int          @default(0)
  lastFailureAt      DateTime?    @db.Timestamptz(3)
  deactivatedAt      DateTime?    @db.Timestamptz(3)
  deactivationReason String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([userId, isActive])
}

/// One delivery attempt record per (notification, subscription). Makes push idempotent across
/// retries (only non-SENT rows are retried) and records the push service's answer.
model PushDelivery {
  id             String             @id @default(uuid()) @db.Uuid
  notificationId String             @db.Uuid
  subscriptionId String             @db.Uuid
  status         PushDeliveryStatus @default(PENDING)
  attempts       Int                @default(0)
  /// HTTP status from the push service on the last attempt (null = network error / not tried).
  statusCode     Int?
  lastError      String?
  sentAt         DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  notification Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([notificationId, subscriptionId])
  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
}

/* ======================================================================
 * Departments
 * ==================================================================== */

/// Company department. Deactivated, never deleted (tasks keep their historical department).
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  code      String
  nameAr    String
  nameEn    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  memberships DepartmentMembership[]
  tasks       Task[]
  documents   ProjectDocument[]

  @@unique([companyId, code])
  @@unique([companyId, nameAr])
  @@index([companyId, isActive, sortOrder])
}

/// User ↔ department (many-to-many, exactly one primary). Removal is soft so history stays.
model DepartmentMembership {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @db.Uuid
  userId       String    @db.Uuid
  isPrimary    Boolean   @default(false)
  removedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([departmentId, userId])
  @@index([userId, removedAt])
  @@index([departmentId, removedAt])
}

/* ======================================================================
 * Workflow & time ledger
 * ==================================================================== */

/// One work cycle: the initial assignment, then one per reopening. Completion facts are a snapshot
/// written once at approval (immutable).
model TaskCycle {
  id               String    @id @default(uuid()) @db.Uuid
  taskId           String    @db.Uuid
  cycleNo          Int
  startedAt        DateTime  @db.Timestamptz(3)
  /// Deadline at the start of this cycle (preserved).
  originalDeadline DateTime  @db.Timestamptz(3)
  /// Current official deadline of this cycle (changed by approved extensions / manager edits).
  approvedDeadline DateTime  @db.Timestamptz(3)
  reopenReason     String?
  reopenedById     String?   @db.Uuid
  completedAt      DateTime? @db.Timestamptz(3)
  approvedById     String?   @db.Uuid
  accountableMs    BigInt?
  budgetMs         BigInt?
  lateMs           BigInt?
  completedLate    Boolean?
  /// LIVE, or BACKFILL for cycles reconstructed from pre-ledger history.
  source           String    @default("LIVE")
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  task        Task                       @relation(fields: [taskId], references: [id], onDelete: Restrict)
  segments    TaskTimeSegment[]
  submissions TaskSubmission[]
  transfers   TaskTransfer[]
  extensions  DeadlineExtensionRequest[]

  @@unique([taskId, cycleNo])
}

/// Append-only accountable-time ledger. Exactly one open segment per open task; closed rows are
/// immutable (DB trigger). See docs/TIME_ACCOUNTING.md for the charging rules.
model TaskTimeSegment {
  id                String      @id @default(uuid()) @db.Uuid
  taskId            String      @db.Uuid
  cycleId           String      @db.Uuid
  kind              SegmentKind
  /// Whose clock this is while open (null for manager review).
  responsibleUserId String?     @db.Uuid
  /// Set when closed: who the time is charged to; null when excluded or still open.
  chargedToUserId   String?     @db.Uuid
  /// True once closed and counted in accountable time.
  charged           Boolean     @default(false)
  startedAt         DateTime    @db.Timestamptz(3)
  endedAt           DateTime?   @db.Timestamptz(3)
  submissionId      String?     @db.Uuid
  transferId        String?     @db.Uuid
  closeReason       String?
  source            String      @default("LIVE")

  task  Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  cycle TaskCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([cycleId, startedAt])
  @@index([chargedToUserId, startedAt])
  @@index([taskId, startedAt])
}

/// Immutable completion submission (comment + attachments live on `comment`).
model TaskSubmission {
  id              String           @id @default(uuid()) @db.Uuid
  taskId          String           @db.Uuid
  cycleId         String           @db.Uuid
  submittedById   String           @db.Uuid
  commentId       String           @unique @db.Uuid
  stage           ReviewStage
  reviewerId      String           @db.Uuid
  status          SubmissionStatus @default(PENDING)
  /// For a MANAGER-stage submission created by a delegator's forward: the delegate submission it forwards.
  forwardedFromId String?          @db.Uuid
  decidedById     String?          @db.Uuid
  decidedAt       DateTime?        @db.Timestamptz(3)
  decisionReason  String?
  /// Admin break-glass decision (approver bypassed by ADMIN, audited).
  decidedAsAdmin  Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  task          Task            @relation(fields: [taskId], references: [id], onDelete: Restrict)
  cycle         TaskCycle       @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  submittedBy   User            @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)
  comment       TaskComment     @relation(fields: [commentId], references: [id], onDelete: Restrict)
  forwardedFrom TaskSubmission? @relation("SubmissionForward", fields: [forwardedFromId], references: [id], onDelete: Restrict)
  forwards      TaskSubmission[] @relation("SubmissionForward")
  documents     ProjectDocument[]

  @@index([taskId, createdAt])
  @@index([reviewerId, status])
}

model TaskTransfer {
  id               String         @id @default(uuid()) @db.Uuid
  taskId           String         @db.Uuid
  cycleId          String         @db.Uuid
  fromUserId       String         @db.Uuid
  toUserId         String         @db.Uuid
  reason           String
  status           TransferStatus @default(PENDING)
  /// Position in the delegation chain of the cycle (1 = first hop).
  depth            Int
  parentTransferId String?        @db.Uuid
  requestedAt      DateTime       @default(now()) @db.Timestamptz(3)
  respondedAt      DateTime?      @db.Timestamptz(3)
  responseNote     String?
  /// Set when the work came back up past this hop (delegate's work forwarded or task returned up).
  closedAt         DateTime?      @db.Timestamptz(3)

  task   Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  cycle  TaskCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  from   User      @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to     User      @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([taskId, requestedAt])
  @@index([toUserId, status])
}

model DeadlineExtensionRequest {
  id                String          @id @default(uuid()) @db.Uuid
  taskId            String          @db.Uuid
  cycleId           String          @db.Uuid
  requestedById     String          @db.Uuid
  reason            String
  requestedMinutes  Int
  status            ExtensionStatus @default(PENDING)
  grantedMinutes    Int?
  previousDeadline  DateTime        @db.Timestamptz(3)
  newDeadline       DateTime?       @db.Timestamptz(3)
  decidedById       String?         @db.Uuid
  decidedAt         DateTime?       @db.Timestamptz(3)
  decisionNote      String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  cycle       TaskCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  requestedBy User      @relation("ExtensionRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

/* ======================================================================
 * Project documents
 * ==================================================================== */

model DocumentCategory {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  code      String
  nameAr    String
  nameEn    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documents ProjectDocument[]

  @@unique([companyId, code])
}

/// Project Documents Center entry. Task-sourced documents reuse the attachment's S3 object
/// (no copy); manual uploads carry their own object.
model ProjectDocument {
  id           String             @id @default(uuid()) @db.Uuid
  projectId    String             @db.Uuid
  categoryId   String             @db.Uuid
  title        String
  description  String?
  source       DocumentSource
  visibility   DocumentVisibility
  attachmentId String?            @unique @db.Uuid
  storageKey   String?            @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  status       AttachmentStatus   @default(UPLOADED)
  taskId       String?            @db.Uuid
  submissionId String?            @db.Uuid
  departmentId String?            @db.Uuid
  uploadedById String             @db.Uuid
  archivedAt   DateTime?          @db.Timestamptz(3)
  archivedById String?            @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  category   DocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachment TaskAttachment?  @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  task       Task?            @relation(fields: [taskId], references: [id], onDelete: Restrict)
  submission TaskSubmission?  @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  department Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  uploadedBy User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId, archivedAt, createdAt])
  @@index([projectId, categoryId])
}

/* ======================================================================
 * Personal tasks (owner-only, encrypted title/notes)
 * ==================================================================== */

/// Private to its owner. Never joined with company data. Title/notes are AES-256-GCM ciphertext.
model PersonalTask {
  id          String             @id @default(uuid()) @db.Uuid
  ownerId     String             @db.Uuid
  titleEnc    String
  notesEnc    String?
  dueAt       DateTime?          @db.Timestamptz(3)
  priority    TaskPriority       @default(MEDIUM)
  status      PersonalTaskStatus @default(OPEN)
  completedAt DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, dueAt])
}

/* ======================================================================
 * Reports & audit
 * ==================================================================== */

/// PDF report job. The API builds the authorized dataset; the worker only renders it.
model ReportJob {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String       @db.Uuid
  requestedById   String       @db.Uuid
  type            ReportType
  params          Json
  /// Decided by the API at request time (authorized managers/admins only).
  includesRatings Boolean      @default(false)
  locale          String       @default("ar")
  dataset         Json?
  status          ReportStatus @default(QUEUED)
  storageKey      String?
  sizeBytes       Int?
  error           String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  startedAt       DateTime?    @db.Timestamptz(3)
  completedAt     DateTime?    @db.Timestamptz(3)
  expiresAt       DateTime     @db.Timestamptz(3)

  requestedBy User @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById, createdAt])
  @@index([status, createdAt])
}

/// Administrative audit trail (accounts, departments, memberships). Never contains secrets.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String   @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([companyId, createdAt])
}

/// Transactional outbox. Written in the same DB transaction as the business change and
/// relayed to SQS by the worker.
model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  type        String
  aggregateId String       @db.Uuid
  payload     Json
  dedupeKey   String       @unique
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @db.Timestamptz(3)
  publishedAt DateTime?    @db.Timestamptz(3)
  lastError   String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt])
}

/// Local-development replacement for EventBridge Scheduler one-time schedules.
model ScheduledEvent {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  runAt     DateTime  @db.Timestamptz(3)
  payload   Json
  firedAt   DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([firedAt, runAt])
}
