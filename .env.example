# -----------------------------------------------------------------------------
# DailyTasks environment template.
# docker compose works with NO .env file (safe local defaults are built in).
# Copy to .env only to override. Never commit real secrets.
# -----------------------------------------------------------------------------

# ---------- docker compose overrides (local development) ----------
POSTGRES_USER=dailytasks
POSTGRES_PASSWORD=dailytasks
POSTGRES_DB=dailytasks
# Host ports. Postgres defaults to 5433 to avoid clashing with a locally installed Postgres.
POSTGRES_PORT=5433
API_PORT=3000
WEB_PORT=3001
LOCALSTACK_PORT=4566
# Local auth only. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=local-development-only-secret-change-me-0123456789
# Demo data (development only)
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Password123!
# Where browsers reach S3 for pre-signed URLs. To test the PWA on a phone over the LAN use your LAN IP, e.g. http://192.168.1.20:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
CORS_ORIGINS=http://localhost:3001
# Push: still sent via Expo until the Web Push migration (see docs/PWA.md). Token optional.
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# ---------- API (apps/api) ----------
# NODE_ENV=development|test|production
# PORT=3000
# DATABASE_URL=postgresql://dailytasks:dailytasks@localhost:5433/dailytasks?schema=public
#   On ECS, DATABASE_URL is built automatically from DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_NAME (Secrets Manager).
# AUTH_MODE=local|cognito          (production MUST be cognito)
# JWT_SECRET=...                   (local mode only, >= 32 chars)
# JWT_ACCESS_TTL_SECONDS=3600
# JWT_REFRESH_TTL_SECONDS=2592000
# COGNITO_USER_POOL_ID=me-central-1_XXXXXXXXX
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_REGION=me-central-1
# AWS_ENDPOINT_URL=                (LocalStack only, e.g. http://localhost:4566; empty on AWS)
# S3_BUCKET=dailytasks-attachments
# S3_FORCE_PATH_STYLE=false        (true for LocalStack)
# SQS_EVENTS_QUEUE_URL=https://sqs.me-central-1.amazonaws.com/123456789012/dailytasks-production-events
# SWAGGER_ENABLED=true
# RUN_MIGRATIONS=false             (container entrypoint runs `prisma migrate deploy` when true)

# ---------- Worker (apps/worker) ----------
# SCHEDULER_MODE=local|eventbridge
# SCHEDULER_GROUP_NAME=dailytasks-production
# SCHEDULER_TARGET_QUEUE_ARN=arn:aws:sqs:...:dailytasks-production-events
# SCHEDULER_ROLE_ARN=arn:aws:iam::...:role/...
# HEALTH_PORT=3002
# OUTBOX_POLL_INTERVAL_MS=1000
# LOCAL_SCHEDULER_POLL_INTERVAL_MS=15000
# PUSH_RECEIPT_CHECK_INTERVAL_MS=900000

# ---------- Web (apps/web) ----------
# API_INTERNAL_URL=http://localhost:3000/api/v1   (server-side only; the browser talks to /bff)
# COOKIE_SECURE=true                               (true behind HTTPS)
